<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="UnusedAttribute">
        <!-- Test hook for the emulator test; not present in release builds. -->
        <receiver android:name=".DebugHooks" android:exported="true" tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.epubforge.debug.BACKUP" />
                <action android:name="com.epubforge.debug.RESTORE" />
                <action android:name="com.epubforge.debug.SYNC" />
                <action android:name="com.epubforge.debug.IMPORT" />
                <action android:name="com.epubforge.debug.CHECK_UPDATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
